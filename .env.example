# App
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
APP_NAME=Surfwatch
CORS_ORIGINS=["http://localhost:3000"]

# Database
POSTGRES_USER=surfwatch
POSTGRES_PASSWORD=surfwatch
POSTGRES_DB=surfwatch    
DATABASE_URL=postgresql://surfwatch:surfwatch@localhost:5432/surfwatch
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30

# Auth (generate the key pair with `python scripts/generate_jwt_keys.py`)
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_KEY_ID=local-1
JWT_ISSUER=surfwatch
JWT_AUDIENCE=surfwatch-api
JWT_LEEWAY_SECONDS=10
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
